<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="JMT-MS-12 - Story LF-81 Appeal Send Load">
      <stringProp name="TestPlan.comments">Story LF-81, the send path under concurrency: how POST /api/matches/appeals behaves when many users appeal below-threshold pairs at once. AppealServiceTests covers the single-caller rules (note length, contact details, previewVersion 409, duplicate 409, &quot;can be claimed directly&quot; 422) one at a time, and this plan measures what that says nothing about - throughput and error rate of the write path once N genuine appeals are in flight together.

Every thread walks the real two-step user journey rather than posting blind, because the endpoint is deliberately unforgiving about it: it requires a previewVersion that is a fingerprint of the pair&apos;s CURRENT state, so a thread that skipped the preview would be rejected with 400 for a reason that has nothing to do with load. Each thread therefore previews its own row, extracts its own genuine previewVersion, and sends.

APPEAL_PAIRS_CSV rows must each be a DISTINCT below-threshold pair. Two constraints make that non-negotiable and are worth stating plainly:
  - a pair can hold only one appeal (uq_match_appeals_item_pair), so a recycled row would answer 409 &quot;you already appealed this&quot; and would be measuring the duplicate guard, not the send path;
  - a pair scoring &gt;= 60% is refused with 422, so above-threshold rows would fail for the wrong reason.
Provide at least THREADS rows; the CSV is deliberately NOT recycled, so a short file shows up as malformed requests rather than as a plausible-looking run that quietly measured the wrong thing.

HOST/PORT default to localhost/5179. AUTH_TOKEN is the JWT of a user who owns one of each row&apos;s LOST reports (the claimant role) and has verified email plus a phone number on file.</stringProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments">
        <collectionProp name="Arguments.arguments">
          <elementProp name="HOST" elementType="Argument">
            <stringProp name="Argument.name">HOST</stringProp>
            <stringProp name="Argument.value">${__P(HOST,localhost)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="PORT" elementType="Argument">
            <stringProp name="Argument.name">PORT</stringProp>
            <stringProp name="Argument.value">${__P(PORT,5179)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="AUTH_TOKEN" elementType="Argument">
            <stringProp name="Argument.name">AUTH_TOKEN</stringProp>
            <stringProp name="Argument.value">${__P(AUTH_TOKEN,SET_ME)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="THREADS" elementType="Argument">
            <stringProp name="Argument.name">THREADS</stringProp>
            <stringProp name="Argument.value">${__P(THREADS,20)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="RAMP_SECONDS" elementType="Argument">
            <stringProp name="Argument.name">RAMP_SECONDS</stringProp>
            <stringProp name="Argument.value">${__P(RAMP_SECONDS,10)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="PAIRS_CSV" elementType="Argument">
            <stringProp name="Argument.name">PAIRS_CSV</stringProp>
            <stringProp name="Argument.value">${__P(PAIRS_CSV,storyLF81-appeal-pairs.csv)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
        </collectionProp>
      </elementProp>
    </TestPlan>
    <hashTree>
      <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="Owner authentication + JSON content type">
        <collectionProp name="HeaderManager.headers">
          <elementProp name="auth-cookie" elementType="Header">
            <stringProp name="Header.name">Cookie</stringProp>
            <stringProp name="Header.value">auth_token=${AUTH_TOKEN}</stringProp>
          </elementProp>
          <elementProp name="content-type" elementType="Header">
            <stringProp name="Header.name">Content-Type</stringProp>
            <stringProp name="Header.value">application/json</stringProp>
          </elementProp>
        </collectionProp>
        <stringProp name="TestPlan.comments">Sends the JWT as the auth_token cookie (MatchingService&apos;s JWT bearer handler accepts it as a fallback - ClaimRegistration.cs).</stringProp>
      </HeaderManager>
      <hashTree/>
      <CSVDataSet guiclass="TestBeanGUI" testclass="CSVDataSet" testname="Story LF-81 distinct appealable pairs" enabled="true">
        <stringProp name="TestPlan.comments">One row per appeal, never recycled. recycle=false + stopThread=false is the honest configuration here: if the file is shorter than THREADS the later threads run with empty ids and their samplers fail loudly, which is much better than silently re-appealing a pair and reporting a green run full of 409s.</stringProp>
        <stringProp name="filename">${PAIRS_CSV}</stringProp>
        <stringProp name="fileEncoding">UTF-8</stringProp>
        <stringProp name="variableNames">lostItemId,foundItemId</stringProp>
        <boolProp name="ignoreFirstLine">false</boolProp>
        <stringProp name="delimiter">,</stringProp>
        <boolProp name="quotedData">false</boolProp>
        <boolProp name="recycle">false</boolProp>
        <boolProp name="stopThread">false</boolProp>
        <stringProp name="shareMode">shareMode.all</stringProp>
      </CSVDataSet>
      <hashTree/>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Concurrent appellant browsers" enabled="true">
        <stringProp name="TestPlan.comments">A ramp-up rather than a Synchronizing Timer, unlike plan 13: this is a throughput question, so the arrivals are spread out the way real users arrive. Allocating every thread at one instant would measure lock contention on the insert instead.</stringProp>
        <stringProp name="ThreadGroup.num_threads">${THREADS}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">${RAMP_SECONDS}</stringProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController">
          <stringProp name="LoopController.loops">1</stringProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </ThreadGroup>
      <hashTree>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Preview this thread's pair" enabled="true">
          <stringProp name="TestPlan.comments">Each thread previews its own row to obtain a real previewVersion. Also the plan&apos;s own data check: a 200 here proves the pair is still ACTIVE on both sides, so any later failure is about the appeal rather than about stale CSV rows.</stringProp>
          <stringProp name="HTTPSampler.domain">${HOST}</stringProp>
          <stringProp name="HTTPSampler.port">${PORT}</stringProp>
          <stringProp name="HTTPSampler.protocol">http</stringProp>
          <stringProp name="HTTPSampler.path">/api/matches/preview</stringProp>
          <stringProp name="HTTPSampler.method">POST</stringProp>
          <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
            <collectionProp name="Arguments.arguments">
              <elementProp name="" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">{&quot;lostItemId&quot;:&quot;${lostItemId}&quot;,&quot;foundItemId&quot;:&quot;${foundItemId}&quot;}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
            </collectionProp>
          </elementProp>
        </HTTPSamplerProxy>
        <hashTree>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Preview returns 200" enabled="true">
            <collectionProp name="Asserion.test_strings">
              <stringProp name="49586">200</stringProp>
            </collectionProp>
            <stringProp name="TestPlan.comments">A failure here means a CSV row is stale: an item was deleted or resolved since the file was written.</stringProp>
            <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
            <intProp name="Assertion.test_type">8</intProp>
            <stringProp name="Assertion.custom_message"></stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
          </ResponseAssertion>
          <hashTree/>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Preview reports the pair is not directly claimable" enabled="true">
            <collectionProp name="Asserion.test_strings">
              <stringProp name="49587">&quot;canClaim&quot;:false</stringProp>
            </collectionProp>
            <stringProp name="TestPlan.comments">canClaim must be false: the endpoint refuses with 422 anything the user could simply claim instead. Asserting the exact &quot;canClaim&quot;:false key rather than a bare &quot;false&quot; matters - the preview body carries a breakdown full of 0s and other booleans, so a loose substring match would sail through on an unrelated field and would never actually catch the above-threshold CSV row this is here to catch. Turns that mistake into a clear named failure rather than a bare 422 several samplers later.</stringProp>
            <stringProp name="Assertion.test_field">Assertion.response_data</stringProp>
            <intProp name="Assertion.test_type">16</intProp>
            <stringProp name="Assertion.custom_message"></stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
          </ResponseAssertion>
          <hashTree/>
          <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="Extract previewVersion" enabled="true">
            <stringProp name="JSONPostProcessor.referenceNames">previewVersion</stringProp>
            <stringProp name="JSONPostProcessor.jsonPathExprs">$.previewVersion</stringProp>
            <stringProp name="JSONPostProcessor.match_numbers">0</stringProp>
          </JSONPostProcessor>
          <hashTree/>
        </hashTree>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Send this thread's appeal" enabled="true">
          <stringProp name="TestPlan.comments">The sampler under load. The note carries the thread number purely so a captured JTL row can be traced back to the CSV line that produced it.</stringProp>
          <stringProp name="HTTPSampler.domain">${HOST}</stringProp>
          <stringProp name="HTTPSampler.port">${PORT}</stringProp>
          <stringProp name="HTTPSampler.protocol">http</stringProp>
          <stringProp name="HTTPSampler.path">/api/matches/appeals</stringProp>
          <stringProp name="HTTPSampler.method">POST</stringProp>
          <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
            <collectionProp name="Arguments.arguments">
              <elementProp name="" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">{&quot;lostItemId&quot;:&quot;${lostItemId}&quot;,&quot;foundItemId&quot;:&quot;${foundItemId}&quot;,&quot;previewVersion&quot;:&quot;${previewVersion}&quot;,&quot;note&quot;:&quot;JMeter LF-81 load appeal from thread ${__threadNum}.&quot;}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
            </collectionProp>
          </elementProp>
        </HTTPSamplerProxy>
        <hashTree>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Appeal created returns 201" enabled="true">
            <collectionProp name="Asserion.test_strings">
              <stringProp name="49588">201</stringProp>
            </collectionProp>
            <stringProp name="TestPlan.comments">201 only. A 409 means either the pair was already appealed or the reports changed mid-run; a 422 means the pair was claimable. Both are data-setup faults and are left failing rather than tolerated, because &quot;accept 409 as well&quot; is precisely how a load test ends up reporting a clean run while measuring nothing.</stringProp>
            <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
            <intProp name="Assertion.test_type">8</intProp>
            <stringProp name="Assertion.custom_message"></stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
          </ResponseAssertion>
          <hashTree/>
        </hashTree>
      </hashTree>
      <ResultCollector guiclass="ViewResultsFullVisualizer" testclass="ResultCollector" testname="View Results Tree">
        <boolProp name="ResultCollector.error_logging">false</boolProp>
        <objProp>
          <name>saveConfig</name>
          <value class="SampleSaveConfiguration">
            <time>true</time>
            <latency>true</latency>
            <timestamp>true</timestamp>
            <success>true</success>
            <label>true</label>
            <code>true</code>
            <message>true</message>
            <threadName>true</threadName>
            <dataType>true</dataType>
            <encoding>false</encoding>
            <assertions>true</assertions>
            <subresults>true</subresults>
            <responseData>false</responseData>
            <samplerData>false</samplerData>
            <xml>false</xml>
            <fieldNames>true</fieldNames>
            <responseHeaders>false</responseHeaders>
            <requestHeaders>false</requestHeaders>
            <responseDataOnError>false</responseDataOnError>
            <saveAssertionResultsFailureMessage>true</saveAssertionResultsFailureMessage>
            <assertionsResultsToSave>0</assertionsResultsToSave>
            <bytes>true</bytes>
            <sentBytes>true</sentBytes>
            <url>true</url>
            <threadCounts>true</threadCounts>
            <idleTime>true</idleTime>
            <connectTime>true</connectTime>
          </value>
        </objProp>
        <stringProp name="filename">../results/storyLF81-appeal-send-tree.jtl</stringProp>
      </ResultCollector>
      <hashTree/>
      <ResultCollector guiclass="SummaryReport" testclass="ResultCollector" testname="Summary Report">
        <boolProp name="ResultCollector.error_logging">false</boolProp>
        <objProp>
          <name>saveConfig</name>
          <value class="SampleSaveConfiguration">
            <time>true</time>
            <latency>true</latency>
            <timestamp>true</timestamp>
            <success>true</success>
            <label>true</label>
            <code>true</code>
            <message>true</message>
            <threadName>true</threadName>
            <dataType>true</dataType>
            <encoding>false</encoding>
            <assertions>true</assertions>
            <subresults>true</subresults>
            <responseData>false</responseData>
            <samplerData>false</samplerData>
            <xml>false</xml>
            <fieldNames>true</fieldNames>
            <responseHeaders>false</responseHeaders>
            <requestHeaders>false</requestHeaders>
            <responseDataOnError>false</responseDataOnError>
            <saveAssertionResultsFailureMessage>true</saveAssertionResultsFailureMessage>
            <assertionsResultsToSave>0</assertionsResultsToSave>
            <bytes>true</bytes>
            <sentBytes>true</sentBytes>
            <url>true</url>
            <threadCounts>true</threadCounts>
            <idleTime>true</idleTime>
            <connectTime>true</connectTime>
          </value>
        </objProp>
        <stringProp name="filename">../results/storyLF81-appeal-send-summary.jtl</stringProp>
      </ResultCollector>
      <hashTree/>
    </hashTree>
  </hashTree>
</jmeterTestPlan>