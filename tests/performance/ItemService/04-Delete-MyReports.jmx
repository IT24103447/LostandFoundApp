<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="JMT-IS-04 - Controlled Create, Update, Delete Lifecycle" enabled="true">
      <stringProp name="TestPlan.comments">Stories 1, 3, 7 and 8 reliability flow. A single owner creates a disposable report, updates it, reads their history, deletes it, then confirms public details return 404. The test extracts the new ID itself, so no local SQL data is needed. It is deliberately single-threaded because it changes state.</stringProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments">
        <collectionProp name="Arguments.arguments">
          <elementProp name="HOST" elementType="Argument"><stringProp name="Argument.name">HOST</stringProp><stringProp name="Argument.value">${__P(HOST,localhost)}</stringProp></elementProp>
          <elementProp name="PORT" elementType="Argument"><stringProp name="Argument.name">PORT</stringProp><stringProp name="Argument.value">${__P(PORT,5001)}</stringProp></elementProp>
          <elementProp name="AUTH_TOKEN" elementType="Argument"><stringProp name="Argument.name">AUTH_TOKEN</stringProp><stringProp name="Argument.value">${__P(AUTH_TOKEN,SET_ME)}</stringProp></elementProp>
        </collectionProp>
      </elementProp>
    </TestPlan>
    <hashTree>
      <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="Owner authentication" enabled="true">
        <collectionProp name="HeaderManager.headers"><elementProp name="auth-cookie" elementType="Header"><stringProp name="Header.name">Cookie</stringProp><stringProp name="Header.value">auth_token=${AUTH_TOKEN}</stringProp></elementProp></collectionProp>
      </HeaderManager>
      <hashTree/>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Single lifecycle execution" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">STOPTHREAD</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController"><stringProp name="LoopController.loops">1</stringProp><boolProp name="LoopController.continue_forever">false</boolProp></elementProp>
        <stringProp name="ThreadGroup.num_threads">1</stringProp><stringProp name="ThreadGroup.ramp_time">1</stringProp>
      </ThreadGroup>
      <hashTree>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Story 1 - Create disposable lost report" enabled="true">
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments"><collectionProp name="Arguments.arguments">
            <elementProp name="Title" elementType="HTTPArgument"><stringProp name="Argument.name">Title</stringProp><stringProp name="Argument.value">JM-Lifecycle-${__UUID}</stringProp></elementProp>
            <elementProp name="Category" elementType="HTTPArgument"><stringProp name="Argument.name">Category</stringProp><stringProp name="Argument.value">Accessories</stringProp></elementProp>
            <elementProp name="Description" elementType="HTTPArgument"><stringProp name="Argument.name">Description</stringProp><stringProp name="Argument.value">Disposable lifecycle report</stringProp></elementProp>
            <elementProp name="DateLost" elementType="HTTPArgument"><stringProp name="Argument.name">DateLost</stringProp><stringProp name="Argument.value">2026-09-01</stringProp></elementProp>
            <elementProp name="LastKnownLocation" elementType="HTTPArgument"><stringProp name="Argument.name">LastKnownLocation</stringProp><stringProp name="Argument.value">QA location</stringProp></elementProp>
            <elementProp name="HiddenInformation" elementType="HTTPArgument"><stringProp name="Argument.name">HiddenInformation</stringProp><stringProp name="Argument.value">JM-lifecycle-private</stringProp></elementProp>
          </collectionProp></elementProp>
          <stringProp name="HTTPSampler.domain">${HOST}</stringProp><stringProp name="HTTPSampler.port">${PORT}</stringProp><stringProp name="HTTPSampler.protocol">http</stringProp><stringProp name="HTTPSampler.path">/api/items/lost</stringProp><stringProp name="HTTPSampler.method">POST</stringProp><boolProp name="HTTPSampler.DO_MULTIPART_POST">true</boolProp>
        </HTTPSamplerProxy>
        <hashTree>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Create returns 201" enabled="true"><collectionProp name="Asserion.test_strings"><stringProp name="1">201</stringProp></collectionProp><stringProp name="Assertion.test_field">Assertion.response_code</stringProp><intProp name="Assertion.test_type">8</intProp></ResponseAssertion><hashTree/>
          <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="Extract created item ID" enabled="true"><stringProp name="JSONPostProcessor.referenceNames">createdItemId</stringProp><stringProp name="JSONPostProcessor.jsonPathExprs">$.id</stringProp><stringProp name="JSONPostProcessor.match_numbers">0</stringProp></JSONPostProcessor><hashTree/>
        </hashTree>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Story 3 - Update created report" enabled="true">
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments"><collectionProp name="Arguments.arguments">
            <elementProp name="Title" elementType="HTTPArgument"><stringProp name="Argument.name">Title</stringProp><stringProp name="Argument.value">JM-Lifecycle-Updated</stringProp></elementProp>
            <elementProp name="Category" elementType="HTTPArgument"><stringProp name="Argument.name">Category</stringProp><stringProp name="Argument.value">Accessories</stringProp></elementProp>
            <elementProp name="Description" elementType="HTTPArgument"><stringProp name="Argument.name">Description</stringProp><stringProp name="Argument.value">Updated lifecycle report</stringProp></elementProp>
            <elementProp name="DateLost" elementType="HTTPArgument"><stringProp name="Argument.name">DateLost</stringProp><stringProp name="Argument.value">2026-09-01</stringProp></elementProp>
            <elementProp name="LastKnownLocation" elementType="HTTPArgument"><stringProp name="Argument.name">LastKnownLocation</stringProp><stringProp name="Argument.value">QA location</stringProp></elementProp>
            <elementProp name="HiddenInformation" elementType="HTTPArgument"><stringProp name="Argument.name">HiddenInformation</stringProp><stringProp name="Argument.value">JM-lifecycle-private</stringProp></elementProp>
          </collectionProp></elementProp>
          <stringProp name="HTTPSampler.domain">${HOST}</stringProp><stringProp name="HTTPSampler.port">${PORT}</stringProp><stringProp name="HTTPSampler.protocol">http</stringProp><stringProp name="HTTPSampler.path">/api/items/lost/${createdItemId}</stringProp><stringProp name="HTTPSampler.method">PUT</stringProp><boolProp name="HTTPSampler.DO_MULTIPART_POST">true</boolProp>
        </HTTPSamplerProxy>
        <hashTree><ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Update returns 200" enabled="true"><collectionProp name="Asserion.test_strings"><stringProp name="1">200</stringProp></collectionProp><stringProp name="Assertion.test_field">Assertion.response_code</stringProp><intProp name="Assertion.test_type">8</intProp></ResponseAssertion><hashTree/></hashTree>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Story 8 - Read owner history" enabled="true"><stringProp name="HTTPSampler.domain">${HOST}</stringProp><stringProp name="HTTPSampler.port">${PORT}</stringProp><stringProp name="HTTPSampler.protocol">http</stringProp><stringProp name="HTTPSampler.path">/api/items/lost/mine</stringProp><stringProp name="HTTPSampler.method">GET</stringProp></HTTPSamplerProxy>
        <hashTree><ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="History returns 200" enabled="true"><collectionProp name="Asserion.test_strings"><stringProp name="1">200</stringProp></collectionProp><stringProp name="Assertion.test_field">Assertion.response_code</stringProp><intProp name="Assertion.test_type">8</intProp></ResponseAssertion><hashTree/></hashTree>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Story 7 - Delete disposable report" enabled="true"><stringProp name="HTTPSampler.domain">${HOST}</stringProp><stringProp name="HTTPSampler.port">${PORT}</stringProp><stringProp name="HTTPSampler.protocol">http</stringProp><stringProp name="HTTPSampler.path">/api/items/lost/${createdItemId}</stringProp><stringProp name="HTTPSampler.method">DELETE</stringProp></HTTPSamplerProxy>
        <hashTree><ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Delete returns 200" enabled="true"><collectionProp name="Asserion.test_strings"><stringProp name="1">200</stringProp></collectionProp><stringProp name="Assertion.test_field">Assertion.response_code</stringProp><intProp name="Assertion.test_type">8</intProp></ResponseAssertion><hashTree/></hashTree>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Story 7 - Deleted public details return 404" enabled="true"><stringProp name="HTTPSampler.domain">${HOST}</stringProp><stringProp name="HTTPSampler.port">${PORT}</stringProp><stringProp name="HTTPSampler.protocol">http</stringProp><stringProp name="HTTPSampler.path">/api/items/${createdItemId}</stringProp><stringProp name="HTTPSampler.method">GET</stringProp></HTTPSamplerProxy>
        <hashTree><ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Details return 404" enabled="true"><collectionProp name="Asserion.test_strings"><stringProp name="1">404</stringProp></collectionProp><stringProp name="Assertion.test_field">Assertion.response_code</stringProp><intProp name="Assertion.test_type">8</intProp></ResponseAssertion><hashTree/></hashTree>
      </hashTree>
    </hashTree>
  </hashTree>
</jmeterTestPlan>
