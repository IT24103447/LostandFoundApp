<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="Story 5 - Mark Item Resolved" enabled="true">
      <stringProp name="TestPlan.comments">Set ITEM_BASE_URL, OWNER_AUTH_TOKEN, NONOWNER_AUTH_TOKEN, LOST_ITEM_ID and FOUNDS_ITEM_ID before execution. Use disposable ACTIVE reports: success requests permanently change them to RESOLVED.</stringProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="Variables" enabled="true">
        <collectionProp name="Arguments.arguments">
          <elementProp name="ITEM_BASE_URL" elementType="Argument"><stringProp name="Argument.name">ITEM_BASE_URL</stringProp><stringProp name="Argument.value">${__P(ITEM_BASE_URL,http://localhost:5001)}</stringProp></elementProp>
          <elementProp name="OWNER_AUTH_TOKEN" elementType="Argument"><stringProp name="Argument.name">OWNER_AUTH_TOKEN</stringProp><stringProp name="Argument.value">${__P(OWNER_AUTH_TOKEN,REPLACE_ME)}</stringProp></elementProp>
          <elementProp name="NONOWNER_AUTH_TOKEN" elementType="Argument"><stringProp name="Argument.name">NONOWNER_AUTH_TOKEN</stringProp><stringProp name="Argument.value">${__P(NONOWNER_AUTH_TOKEN,REPLACE_ME)}</stringProp></elementProp>
          <elementProp name="LOST_ITEM_ID" elementType="Argument"><stringProp name="Argument.name">LOST_ITEM_ID</stringProp><stringProp name="Argument.value">${__P(LOST_ITEM_ID,REPLACE_ME)}</stringProp></elementProp>
          <elementProp name="FOUND_ITEM_ID" elementType="Argument"><stringProp name="Argument.name">FOUND_ITEM_ID</stringProp><stringProp name="Argument.value">${__P(FOUND_ITEM_ID,REPLACE_ME)}</stringProp></elementProp>
        </collectionProp>
      </elementProp>
    </TestPlan>
    <hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="PERF-05-01 owner resolves disposable lost report" enabled="true">
        <stringProp name="ThreadGroup.num_threads">1</stringProp><stringProp name="ThreadGroup.ramp_time">1</stringProp><boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp><elementProp name="ThreadGroup.main_controller" elementType="LoopController"><stringProp name="LoopController.loops">1</stringProp><boolProp name="LoopController.continue_forever">false</boolProp></elementProp>
      </ThreadGroup>
      <hashTree>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="POST resolve lost as owner (expects 200)" enabled="true"><stringProp name="HTTPSampler.domain">${__groovy(vars.get('ITEM_BASE_URL').replaceFirst('https?://','').split(':')[0])}</stringProp><stringProp name="HTTPSampler.port">${__groovy(vars.get('ITEM_BASE_URL').tokenize(':')[-1])}</stringProp><stringProp name="HTTPSampler.path">/api/items/lost/${LOST_ITEM_ID}/resolve</stringProp><stringProp name="HTTPSampler.method">POST</stringProp><boolProp name="HTTPSampler.follow_redirects">true</boolProp><boolProp name="HTTPSampler.use_keepalive">true</boolProp></HTTPSamplerProxy>
        <hashTree><HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="Owner auth cookie" enabled="true"><collectionProp name="HeaderManager.headers"><elementProp name="Cookie" elementType="Header"><stringProp name="Header.name">Cookie</stringProp><stringProp name="Header.value">auth_token=${OWNER_AUTH_TOKEN}</stringProp></elementProp></collectionProp></HeaderManager><hashTree/><ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Expected 200" enabled="true"><collectionProp name="Asserion.test_strings"><stringProp name="200">200</stringProp></collectionProp><stringProp name="Assertion.test_field">Assertion.response_code</stringProp><intProp name="Assertion.test_type">8</intProp></ResponseAssertion><hashTree/></hashTree>
      </hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="PERF-05-02 non-owner resolve is rejected" enabled="true">
        <stringProp name="ThreadGroup.num_threads">1</stringProp><stringProp name="ThreadGroup.ramp_time">1</stringProp><elementProp name="ThreadGroup.main_controller" elementType="LoopController"><stringProp name="LoopController.loops">1</stringProp><boolProp name="LoopController.continue_forever">false</boolProp></elementProp>
      </ThreadGroup>
      <hashTree>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="POST resolve found as non-owner (expects 403)" enabled="true"><stringProp name="HTTPSampler.domain">${__groovy(vars.get('ITEM_BASE_URL').replaceFirst('https?://','').split(':')[0])}</stringProp><stringProp name="HTTPSampler.port">${__groovy(vars.get('ITEM_BASE_URL').tokenize(':')[-1])}</stringProp><stringProp name="HTTPSampler.path">/api/items/found/${FOUND_ITEM_ID}/resolve</stringProp><stringProp name="HTTPSampler.method">POST</stringProp><boolProp name="HTTPSampler.follow_redirects">true</boolProp><boolProp name="HTTPSampler.use_keepalive">true</boolProp></HTTPSamplerProxy>
        <hashTree><HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="Non-owner auth cookie" enabled="true"><collectionProp name="HeaderManager.headers"><elementProp name="Cookie" elementType="Header"><stringProp name="Header.name">Cookie</stringProp><stringProp name="Header.value">auth_token=${NONOWNER_AUTH_TOKEN}</stringProp></elementProp></collectionProp></HeaderManager><hashTree/><ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Expected 403" enabled="true"><collectionProp name="Asserion.test_strings"><stringProp name="403">403</stringProp></collectionProp><stringProp name="Assertion.test_field">Assertion.response_code</stringProp><intProp name="Assertion.test_type">8</intProp></ResponseAssertion><hashTree/></hashTree>
      </hashTree>
    </hashTree>
  </hashTree>
</jmeterTestPlan>
