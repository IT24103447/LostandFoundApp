            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Pick how the listing ends">
              <stringProp name="TestPlan.comments">Half the loops also remove the photo; the listing is then deleted, resolved or kept (a third each).</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">def random = new Random()
vars.put('REMOVE_PHOTO', String.valueOf(random.nextBoolean()))
vars.put('LISTING_ENDING', ['delete', 'resolve', 'keep'][random.nextInt(3)])</stringProp>
            </JSR223PostProcessor>
            <hashTree/>
          </hashTree>
        </hashTree>
