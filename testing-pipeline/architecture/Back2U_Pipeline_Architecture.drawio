        </mxCell>
        <mxCell id="c218" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;fontFamily=Helvetica;fontSize=14;fontColor=#2B2B2B;" value="&lt;div style=&quot;font-size:13px;color:#2B2B2B;margin-bottom:0px;line-height:1.38;&quot;&gt;Load&lt;/div&gt;" vertex="1">
          <mxGeometry height="19.94" width="100" x="1110.67" y="1943.73" as="geometry" />
        </mxCell>
        <mxCell id="c219" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;fontFamily=Helvetica;fontSize=14;fontColor=#2B2B2B;" value="&lt;div style=&quot;font-size:13px;color:#2B2B2B;margin-bottom:0px;line-height:1.38;&quot;&gt;Apache JMeter 5.6.3 (checksum-verified, cached), Java 17&lt;/div&gt;" vertex="1">
          <mxGeometry height="19.94" width="387.333" x="1210.67" y="1943.73" as="geometry" />
        </mxCell>
        <mxCell id="c220" parent="1" style="rounded=0;html=1;fillColor=#DADDE2;strokeColor=none;" value="" vertex="1">
          <mxGeometry height="1" width="487.333" x="1110.67" y="1965.67" as="geometry" />
        </mxCell>
        <mxCell id="c221" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;fontFamily=Helvetica;fontSize=14;fontColor=#2B2B2B;" value="&lt;div style=&quot;font-size:13px;color:#2B2B2B;margin-bottom:0px;line-height:1.38;&quot;&gt;UI/E2E&lt;/div&gt;" vertex="1">
          <mxGeometry height="19.94" width="100" x="1110.67" y="1969.67" as="geometry" />
        </mxCell>
        <mxCell id="c222" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;fontFamily=Helvetica;fontSize=14;fontColor=#2B2B2B;" value="&lt;div style=&quot;font-size:13px;color:#2B2B2B;margin-bottom:0px;line-height:1.38;&quot;&gt;Selenium WebDriver 4.25, xUnit 2.9, Chrome&lt;/div&gt;" vertex="1">
          <mxGeometry height="19.94" width="387.333" x="1210.67" y="1969.67" as="geometry" />
        </mxCell>
        <mxCell id="c223" parent="1" style="rounded=0;html=1;fillColor=#DADDE2;strokeColor=none;" value="" vertex="1">
          <mxGeometry height="1" width="487.333" x="1110.67" y="1991.61" as="geometry" />
        </mxCell>
        <mxCell id="c224" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;fontFamily=Helvetica;fontSize=14;fontColor=#2B2B2B;" value="&lt;div style=&quot;font-size:13px;color:#2B2B2B;margin-bottom:0px;line-height:1.38;&quot;&gt;Environment&lt;/div&gt;" vertex="1">
          <mxGeometry height="19.94" width="100" x="1110.67" y="1995.61" as="geometry" />
        </mxCell>
        <mxCell id="c225" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;fontFamily=Helvetica;fontSize=14;fontColor=#2B2B2B;" value="&lt;div style=&quot;font-size:13px;color:#2B2B2B;margin-bottom:0px;line-height:1.38;&quot;&gt;Docker Compose, MySQL 8.0.40, Kafka (Confluent 7.5.0)&lt;/div&gt;" vertex="1">
          <mxGeometry height="19.94" width="387.333" x="1210.67" y="1995.61" as="geometry" />
        </mxCell>
        <mxCell id="c226" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;fontFamily=Helvetica;fontSize=14;fontColor=#2B2B2B;" value="&lt;div style=&quot;font-size:16px;color:#2E3A6E;margin-bottom:0px;line-height:1.38;font-weight:bold;&quot;&gt;Design principles&lt;/div&gt;" vertex="1">
          <mxGeometry height="24.08" width="487.333" x="1103.6200000000001" y="2029.58" as="geometry" />
        </mxCell>
        <mxCell id="c227" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;fontFamily=Helvetica;fontSize=14;fontColor=#2B2B2B;" value="&lt;div style=&quot;font-size:12.5px;color:#2B2B2B;margin-bottom:4px;line-height:1.32;padding-left:16px;text-indent:-12px;&quot;&gt;&amp;#8226;&amp;nbsp;&amp;nbsp;&lt;b&gt;Isolation:&lt;/b&gt; every stage on its own runner and, where needed, its own fresh environment, so results are repeatable and independent.&lt;/div&gt;" vertex="1">
          <mxGeometry height="35" width="487.333" x="1109.67" y="2061.55" as="geometry" />
        </mxCell>
        <mxCell id="c228" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;fontFamily=Helvetica;fontSize=14;fontColor=#2B2B2B;" value="&lt;div style=&quot;font-size:12.5px;color:#2B2B2B;margin-bottom:4px;line-height:1.32;padding-left:16px;text-indent:-12px;&quot;&gt;&amp;#8226;&amp;nbsp;&amp;nbsp;&lt;b&gt;One entry point per stage:&lt;/b&gt; the same run.sh locally and in CI, so a local pass means the same checks.&lt;/div&gt;" vertex="1">
          <mxGeometry height="35" width="487.333" x="1109.67" y="2098.55" as="geometry" />
        </mxCell>
        <mxCell id="c229" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;fontFamily=Helvetica;fontSize=14;fontColor=#2B2B2B;" value="&lt;div style=&quot;font-size:12.5px;color:#2B2B2B;margin-bottom:4px;line-height:1.32;padding-left:16px;text-indent:-12px;&quot;&gt;&amp;#8226;&amp;nbsp;&amp;nbsp;&lt;b&gt;Fail loudly:&lt;/b&gt; thresholds, mutation gates, coverage checks and report validation turn quality problems into a failed run, not a footnote.&lt;/div&gt;" vertex="1">
          <mxGeometry height="35" width="487.333" x="1109.67" y="2135.55" as="geometry" />
        </mxCell>
        <mxCell id="c230" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;fontFamily=Helvetica;fontSize=14;fontColor=#2B2B2B;" value="&lt;div style=&quot;font-size:12.5px;color:#2B2B2B;margin-bottom:4px;line-height:1.32;padding-left:16px;text-indent:-12px;&quot;&gt;&amp;#8226;&amp;nbsp;&amp;nbsp;&lt;b&gt;No side effects:&lt;/b&gt; nothing touches the deployed system, real users or real email.&lt;/div&gt;" vertex="1">
          <mxGeometry height="18.5" width="487.333" x="1109.67" y="2172.55" as="geometry" />
        </mxCell>
        <mxCell id="c231" parent="1" style="rounded=0;html=1;fillColor=#C9CCD1;strokeColor=none;" value="" vertex="1">
