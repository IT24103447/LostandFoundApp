        <mxCell id="c213" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;fontFamily=Helvetica;fontSize=14;fontColor=#2B2B2B;" value="&lt;div style=&quot;font-size:13px;color:#2B2B2B;margin-bottom:0px;line-height:1.38;&quot;&gt;.NET 8, xUnit 2.5, Moq 4.20&lt;/div&gt;" vertex="1">
          <mxGeometry height="19.94" width="387.333" x="1210.67" y="1891.85" as="geometry" />
        </mxCell>
        <mxCell id="c214" parent="1" style="rounded=0;html=1;fillColor=#DADDE2;strokeColor=none;" value="" vertex="1">
