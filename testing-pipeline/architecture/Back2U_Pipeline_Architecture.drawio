          <mxGeometry height="19.94" width="150" x="1040.75" y="1442.89" as="geometry" />
        </mxCell>
        <mxCell id="c151" parent="1" style="rounded=1;arcSize=50;html=1;fillColor=#E8F3E8;strokeColor=none;fontColor=#2E6533;fontSize=12;fontFamily=Helvetica;" value="passed" vertex="1">
          <mxGeometry height="19" width="68" x="1183.75" y="1446.83" as="geometry" />
        </mxCell>
        <mxCell id="c152" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;fontFamily=Helvetica;fontSize=14;fontColor=#2B2B2B;" value="&lt;div style=&quot;font-size: 14px; color: rgb(43, 43, 43); margin-bottom: 8px; line-height: 1.38;&quot;&gt;&lt;ul&gt;&lt;li&gt;Downloads every ase-* artifact and reads each category&#39;s status.txt&lt;/li&gt;&lt;li&gt;Published as one table on the run&#39;s summary page&lt;/li&gt;&lt;li&gt;The run fails on any failed, blocked or missing result&lt;/li&gt;&lt;li&gt;Strict mode also fails unfinished categories&lt;/li&gt;&lt;li&gt;Every result is a possible download&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="178.49" width="294" x="1286" y="1318.0500000000002" as="geometry" />
        </mxCell>
        <mxCell id="c155" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;fontFamily=Helvetica;fontSize=20;fontColor=#2B2B2B;" value="&lt;div style=&quot;font-size: 18.5px; color: rgb(46, 101, 51); margin-bottom: 0px; line-height: 1.38;&quot;&gt;Every job writes&lt;/div&gt;" vertex="1">
          <mxGeometry height="19.25" width="150" x="767" y="1214.58" as="geometry" />
        </mxCell>
        <mxCell id="c157" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;fontFamily=Helvetica;fontSize=14;fontColor=#2B2B2B;" value="&lt;div style=&quot;font-size:14px;color:#2E3A6E;margin-bottom:0px;line-height:1.38;font-weight:bold;&quot;&gt;Arrows:&lt;/div&gt;" vertex="1">
          <mxGeometry height="21.32" width="70" x="61" y="1548.0900000000001" as="geometry" />
        </mxCell>
        <mxCell id="c159" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;fontFamily=Helvetica;fontSize=15;fontColor=#2B2B2B;" value="&lt;div style=&quot;font-size: 13.5px; color: rgb(43, 43, 43); margin-bottom: 0px; line-height: 1.38;&quot;&gt;job order / request&lt;/div&gt;" vertex="1">
          <mxGeometry height="19.25" width="111.875" x="190" y="1549.16" as="geometry" />
        </mxCell>
        <mxCell id="c161" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;fontFamily=Helvetica;fontSize=15;fontColor=#2B2B2B;" value="&lt;div style=&quot;font-size: 13.5px; color: rgb(43, 43, 43); margin-bottom: 0px; line-height: 1.38;&quot;&gt;environment started for that job&lt;/div&gt;" vertex="1">
          <mxGeometry height="19.25" width="204" x="387.88" y="1550.16" as="geometry" />
        </mxCell>
        <mxCell id="c163" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;fontFamily=Helvetica;fontSize=15;fontColor=#2B2B2B;" value="&lt;div style=&quot;font-size: 13.5px; color: rgb(43, 43, 43); margin-bottom: 0px; line-height: 1.38;&quot;&gt;Kafka events&lt;/div&gt;" vertex="1">
          <mxGeometry height="19.25" width="82.625" x="659.625" y="1550.16" as="geometry" />
        </mxCell>
        <mxCell id="c165" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;fontFamily=Helvetica;fontSize=15;fontColor=#2B2B2B;" value="&lt;div style=&quot;font-size: 13.5px; color: rgb(43, 43, 43); margin-bottom: 0px; line-height: 1.38;&quot;&gt;Reports written&lt;/div&gt;" vertex="1">
          <mxGeometry height="19.25" width="89.375" x="827.25" y="1550.16" as="geometry" />
        </mxCell>
        <mxCell id="c167" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;fontFamily=Helvetica;fontSize=14;fontColor=#2B2B2B;" value="&lt;div style=&quot;font-size: 12.5px; color: rgb(43, 43, 43); margin-bottom: 0px; line-height: 1.38;&quot;&gt;Reports collected&lt;/div&gt;" vertex="1">
          <mxGeometry height="19.25" width="102" x="1002.62" y="1551.16" as="geometry" />
        </mxCell>
        <mxCell id="c168" parent="1" style="rounded=0;html=1;fillColor=#2E3A6E;strokeColor=none;" value="" vertex="1">
          <mxGeometry height="2" width="1542" x="56" y="1592.16" as="geometry" />
        </mxCell>
        <mxCell id="c169" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;fontFamily=Helvetica;fontSize=14;fontColor=#2B2B2B;" value="&lt;div style=&quot;font-size:16px;color:#2E3A6E;margin-bottom:0px;line-height:1.38;font-weight:bold;&quot;&gt;How the pipeline works&lt;/div&gt;" vertex="1">
          <mxGeometry height="24.08" width="487.333" x="56" y="1614.16" as="geometry" />
        </mxCell>
        <mxCell id="c170" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;fontFamily=Helvetica;fontSize=14;fontColor=#2B2B2B;" value="&lt;div style=&quot;font-size:12.5px;color:#2B2B2B;margin-bottom:6px;line-height:1.32;&quot;&gt;Every push or pull request that touches the services, the frontend or the pipeline starts one workflow. It checks the code at four levels, from the inside out: &lt;b&gt;unit tests&lt;/b&gt; check each service&#39;s logic in isolation, &lt;b&gt;mutation testing&lt;/b&gt; checks that those unit tests really catch faults, &lt;b&gt;load testing&lt;/b&gt; checks the running system under many concurrent users, and &lt;b&gt;UI/E2E testing&lt;/b&gt; checks complete user journeys through the real frontend. Each level is owned by one member, runs on its own machine, and reports in the same format, so one table shows the result of the whole run.&lt;/div&gt;" vertex="1">
          <mxGeometry height="117.5" width="487.333" x="56" y="1640.16" as="geometry" />
        </mxCell>
        <mxCell id="c171" parent="1" style="ellipse;html=1;fillColor=#5F646C;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13;fontFamily=Helvetica;" value="1" vertex="1">
          <mxGeometry height="24" width="24" x="56" y="1771.66" as="geometry" />
        </mxCell>
        <mxCell id="c172" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;fontFamily=Helvetica;fontSize=14;fontColor=#2B2B2B;" value="&lt;div style=&quot;font-size:16px;color:#2E3A6E;margin-bottom:0px;line-height:1.38;font-weight:bold;&quot;&gt;Triggers and workflow&lt;/div&gt;" vertex="1">
          <mxGeometry height="24.08" width="454.333" x="86" y="1768.3700000000001" as="geometry" />
        </mxCell>
        <mxCell id="c173" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;fontFamily=Helvetica;fontSize=14;fontColor=#2B2B2B;" value="&lt;div style=&quot;font-size:12.5px;color:#2B2B2B;margin-bottom:4px;line-height:1.32;padding-left:16px;text-indent:-12px;&quot;&gt;&amp;#8226;&amp;nbsp;&amp;nbsp;&lt;b&gt;Push&lt;/b&gt; (any branch) or &lt;b&gt;pull request&lt;/b&gt; into develop or main, when files under services/, frontend/, testing-pipeline/ or the workflow change.&lt;/div&gt;" vertex="1">
          <mxGeometry height="35" width="487.333" x="56" y="1799.66" as="geometry" />
        </mxCell>
        <mxCell id="c174" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;fontFamily=Helvetica;fontSize=14;fontColor=#2B2B2B;" value="&lt;div style=&quot;font-size: 12.5px; color: rgb(43, 43, 43); margin-bottom: 4px; line-height: 1.32; padding-left: 16px; text-indent: -12px;&quot;&gt;•&amp;nbsp;&amp;nbsp;&lt;b&gt;Manual run&lt;/b&gt;: pick one category or all, and a mode. &lt;b&gt;Development&lt;/b&gt; lets unfinished suites report &quot;not implemented&quot;. &lt;b&gt;Strict&lt;/b&gt; requires every selected suite to run and pass. Real failures fail both.&lt;/div&gt;" vertex="1">
          <mxGeometry height="51.5" width="487.333" x="56" y="1836.66" as="geometry" />
        </mxCell>
        <mxCell id="c175" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;fontFamily=Helvetica;fontSize=14;fontColor=#2B2B2B;" value="&lt;div style=&quot;font-size: 12.5px; color: rgb(43, 43, 43); margin-bottom: 4px; line-height: 1.32; padding-left: 16px; text-indent: -12px;&quot;&gt;•&amp;nbsp;&amp;nbsp;Runs on fresh ubuntu-24.04 GitHub runners. Only one run per branch is live. A newer push cancels the older one.&lt;/div&gt;" vertex="1">
          <mxGeometry height="35" width="487.333" x="56" y="1890.16" as="geometry" />
        </mxCell>
        <mxCell id="c176" parent="1" style="ellipse;html=1;fillColor=#2D4C7A;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13;fontFamily=Helvetica;" value="2" vertex="1">
          <mxGeometry height="24" width="24" x="56" y="1937.16" as="geometry" />
        </mxCell>
        <mxCell id="c177" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;fontFamily=Helvetica;fontSize=14;fontColor=#2B2B2B;" value="&lt;div style=&quot;font-size:16px;color:#2E3A6E;margin-bottom:0px;line-height:1.38;font-weight:bold;&quot;&gt;Job 1: unit testing and mocking&lt;/div&gt;" vertex="1">
          <mxGeometry height="24.08" width="454.333" x="86" y="1934.16" as="geometry" />
        </mxCell>
        <mxCell id="c178" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;fontFamily=Helvetica;fontSize=14;fontColor=#2B2B2B;" value="&lt;div style=&quot;font-size: 12.5px; color: rgb(43, 43, 43); margin-bottom: 4px; line-height: 1.32; padding-left: 16px; text-indent: -12px;&quot;&gt;•&amp;nbsp;&amp;nbsp;&lt;b&gt;xUnit 2.5 + Moq 4.20&lt;/b&gt; on .NET 8 and one test project per service.&amp;nbsp;&lt;b&gt;523 cases in 32 stories&lt;/b&gt; (Auth 176, Item 115, Matching 136, Admin Verify 96).&lt;/div&gt;" vertex="1">
          <mxGeometry height="35" width="487.333" x="56" y="1965.16" as="geometry" />
        </mxCell>
        <mxCell id="c179" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;fontFamily=Helvetica;fontSize=14;fontColor=#2B2B2B;" value="&lt;div style=&quot;font-size: 12.5px; color: rgb(43, 43, 43); margin-bottom: 4px; line-height: 1.32; padding-left: 16px; text-indent: -12px;&quot;&gt;•&amp;nbsp;&amp;nbsp;Parameterised [Theory] cases cover boundaries and input rules, Moq test doubles replace repositories, Kafka publishers and HTTP clients, so only the service logic is tested.&lt;/div&gt;" vertex="1">
          <mxGeometry height="51.5" width="487.333" x="56" y="2002.16" as="geometry" />
        </mxCell>
        <mxCell id="c180" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;fontFamily=Helvetica;fontSize=14;fontColor=#2B2B2B;" value="&lt;div style=&quot;font-size: 12.5px; color: rgb(43, 43, 43); margin-bottom: 4px; line-height: 1.32; padding-left: 16px; text-indent: -12px;&quot;&gt;•&amp;nbsp;&amp;nbsp;Runs first and needs no environment. Its result is the &lt;b&gt;baseline, &lt;/b&gt;Mutation testing runs only after a passing baseline. A demo mode paces the output story by story.&lt;/div&gt;" vertex="1">
          <mxGeometry height="35" width="487.333" x="56" y="2055.66" as="geometry" />
        </mxCell>
        <mxCell id="c181" parent="1" style="ellipse;html=1;fillColor=#5F646C;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13;fontFamily=Helvetica;" value="3" vertex="1">
          <mxGeometry height="24" width="24" x="56" y="2102.66" as="geometry" />
        </mxCell>
        <mxCell id="c182" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;fontFamily=Helvetica;fontSize=14;fontColor=#2B2B2B;" value="&lt;div style=&quot;font-size:16px;color:#2E3A6E;margin-bottom:0px;line-height:1.38;font-weight:bold;&quot;&gt;Job 2: three stages in parallel&lt;/div&gt;" vertex="1">
          <mxGeometry height="24.08" width="454.333" x="88" y="2099.66" as="geometry" />
        </mxCell>
        <mxCell id="c183" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;fontFamily=Helvetica;fontSize=14;fontColor=#2B2B2B;" value="&lt;div style=&quot;font-size:12.5px;color:#2B2B2B;margin-bottom:6px;line-height:1.32;&quot;&gt;After unit testing finishes (pass or fail), a matrix starts three runners at once, with fail-fast off, so one stage failing never hides another&#39;s result.&lt;/div&gt;" vertex="1">
          <mxGeometry height="35" width="487.333" x="56" y="2130.66" as="geometry" />
        </mxCell>
        <mxCell id="c184" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;fontFamily=Helvetica;fontSize=14;fontColor=#2B2B2B;" value="&lt;div style=&quot;font-size: 12.5px; color: rgb(43, 43, 43); margin-bottom: 6px; line-height: 1.32;&quot;&gt;&lt;b&gt;&lt;font color=&quot;#4E3C75&quot;&gt;Mutation (Stryker.NET 4.0).&lt;/font&gt;&lt;/b&gt; Makes small changes (&quot;mutants&quot;) to each service&#39;s code and runs that service&#39;s unit tests against each one; a test must fail to &quot;kill&quot; it. One run per service, each gated on its own score, set just under its measured baseline: Auth 81% (gate 75), Item 66% (60), Matching 64% (60), Admin Verify 74% (70). 2,710 mutants in scope. Untested code is reported as a coverage gap, not hidden. No environment needed.&lt;/div&gt;" vertex="1">
          <mxGeometry height="105" width="487.333" x="56" y="2169.66" as="geometry" />
        </mxCell>
        <mxCell id="c185" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;fontFamily=Helvetica;fontSize=14;fontColor=#2B2B2B;" value="&lt;div style=&quot;font-size: 12.5px; color: rgb(43, 43, 43); margin-bottom: 6px; line-height: 1.32;&quot;&gt;&lt;b&gt;&lt;font color=&quot;#22605A&quot;&gt;Load (Apache JMeter 5.6.3).&lt;/font&gt;&lt;/b&gt; 80 s against the running system. 20 steady users with think time, a 20-user spike at 60 s with none, and one admin throughout. Users report, edit, photograph, resolve and delete listings, claim and confirm matches with partner accounts and send appeals, while the admin reviews spam and decides appeals: 34 endpoints over all four services. Judged on error rate (≤ 1%), p95 per endpoint and coverage (every journey ran): 52 checks.&lt;/div&gt;" vertex="1">
          <mxGeometry height="105" width="487.333" x="583.333" y="1612.16" as="geometry" />
        </mxCell>
        <mxCell id="c186" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;fontFamily=Helvetica;fontSize=14;fontColor=#2B2B2B;" value="&lt;div style=&quot;font-size: 12.5px; color: rgb(43, 43, 43); margin-bottom: 6px; line-height: 1.32;&quot;&gt;&lt;b&gt;&lt;font color=&quot;#854A1C&quot;&gt;UI/E2E (Selenium WebDriver 4.25 + xUnit 2.9).&lt;/font&gt;&lt;/b&gt; Headless Chrome drives the real React frontend, and through it all four services. 71 cases built on 14 page objects, grouped Smoke (8), Demo (13) and Full. Each test arranges its own data through the API and saves a screenshot when it fails.&lt;/div&gt;" vertex="1">
          <mxGeometry height="72" width="487.333" x="583.333" y="1717.16" as="geometry" />
        </mxCell>
        <mxCell id="c187" parent="1" style="ellipse;html=1;fillColor=#6B521D;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13;fontFamily=Helvetica;" value="4" vertex="1">
          <mxGeometry height="24" width="24" x="583.333" y="1799.16" as="geometry" />
        </mxCell>
        <mxCell id="c188" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;fontFamily=Helvetica;fontSize=14;fontColor=#2B2B2B;" value="&lt;div style=&quot;font-size:16px;color:#2E3A6E;margin-bottom:0px;line-height:1.38;font-weight:bold;&quot;&gt;Shared test environment&lt;/div&gt;" vertex="1">
          <mxGeometry height="24.08" width="454.333" x="614.333" y="1797.16" as="geometry" />
        </mxCell>
        <mxCell id="c189" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;fontFamily=Helvetica;fontSize=14;fontColor=#2B2B2B;" value="&lt;div style=&quot;font-size:12.5px;color:#2B2B2B;margin-bottom:4px;line-height:1.32;padding-left:16px;text-indent:-12px;&quot;&gt;&amp;#8226;&amp;nbsp;&amp;nbsp;shared/start-environment.sh starts throwaway &lt;b&gt;MySQL 8.0.40&lt;/b&gt; and &lt;b&gt;Kafka (Confluent 7.5.0)&lt;/b&gt; in Docker Compose, creates the four databases and the 13 Kafka topics, then builds and starts Auth, Item, Matching and Admin Verify in Development mode (migrations run, test accounts seeded) and the React frontend.&lt;/div&gt;" vertex="1">
          <mxGeometry height="68" width="487.333" x="583.333" y="1827.16" as="geometry" />
        </mxCell>
        <mxCell id="c190" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;fontFamily=Helvetica;fontSize=14;fontColor=#2B2B2B;" value="&lt;div style=&quot;font-size:12.5px;color:#2B2B2B;margin-bottom:4px;line-height:1.32;padding-left:16px;text-indent:-12px;&quot;&gt;&amp;#8226;&amp;nbsp;&amp;nbsp;Started fresh on every Load and UI/E2E runner, never shared or reused, and stopped afterwards with the logs kept. A category can add its own data through seed-test-data.sh.&lt;/div&gt;" vertex="1">
          <mxGeometry height="51.5" width="487.333" x="583.333" y="1897.16" as="geometry" />
        </mxCell>
        <mxCell id="c191" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;fontFamily=Helvetica;fontSize=14;fontColor=#2B2B2B;" value="&lt;div style=&quot;font-size:12.5px;color:#2B2B2B;margin-bottom:4px;line-height:1.32;padding-left:16px;text-indent:-12px;&quot;&gt;&amp;#8226;&amp;nbsp;&amp;nbsp;Email, Gemini image processing and blob storage are switched off, so no test reaches a real service or person.&lt;/div&gt;" vertex="1">
          <mxGeometry height="35" width="487.333" x="583.333" y="1950.66" as="geometry" />
        </mxCell>
        <mxCell id="c192" parent="1" style="ellipse;html=1;fillColor=#2E6533;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13;fontFamily=Helvetica;" value="5" vertex="1">
          <mxGeometry height="24" width="24" x="583.333" y="1997.66" as="geometry" />
        </mxCell>
        <mxCell id="c193" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;fontFamily=Helvetica;fontSize=14;fontColor=#2B2B2B;" value="&lt;div style=&quot;font-size:16px;color:#2E3A6E;margin-bottom:0px;line-height:1.38;font-weight:bold;&quot;&gt;Unified reporting contract&lt;/div&gt;" vertex="1">
          <mxGeometry height="24.08" width="454.333" x="616.333" y="1996.66" as="geometry" />
        </mxCell>
        <mxCell id="c194" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;fontFamily=Helvetica;fontSize=14;fontColor=#2B2B2B;" value="&lt;div style=&quot;font-size:12.5px;color:#2B2B2B;margin-bottom:4px;line-height:1.32;padding-left:16px;text-indent:-12px;&quot;&gt;&amp;#8226;&amp;nbsp;&amp;nbsp;Each category has exactly one entry point, its run.sh, which CI and local runs both call. It writes summary.md (scope, counts, failures, measurements) and details.json (one case per check, with a description); the runner adds status.txt and console.log.&lt;/div&gt;" vertex="1">
          <mxGeometry height="68" width="487.333" x="583.333" y="2027.66" as="geometry" />
        </mxCell>
        <mxCell id="c195" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;fontFamily=Helvetica;fontSize=14;fontColor=#2B2B2B;" value="&lt;div style=&quot;font-size: 12.5px; color: rgb(43, 43, 43); margin-bottom: 4px; line-height: 1.32; padding-left: 16px; text-indent: -12px;&quot;&gt;•&amp;nbsp;&amp;nbsp;A shared validate-report rejects missing or malformed reports and a failed case reported with exit code 0.&lt;/div&gt;" vertex="1">
          <mxGeometry height="35" width="487.333" x="583.0029999999999" y="2090" as="geometry" />
        </mxCell>
        <mxCell id="c196" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;fontFamily=Helvetica;fontSize=14;fontColor=#2B2B2B;" value="&lt;div style=&quot;font-size: 12.5px; color: rgb(43, 43, 43); margin-bottom: 4px; line-height: 1.32; padding-left: 16px; text-indent: -12px;&quot;&gt;•&amp;nbsp;&amp;nbsp;Native reports travel alongside: TRX files, Stryker HTML, the JMeter dashboard, UI screenshots.&amp;nbsp;&lt;span style=&quot;color: light-dark(rgb(43, 43, 43), rgb(200, 200, 200)); background-color: transparent;&quot;&gt;Each category uploads an ase-&amp;lt;category&amp;gt; artifact (with service logs for Load and UI/E2E), kept 14 days.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="51.5" width="487.333" x="583.333" y="2132.66" as="geometry" />
        </mxCell>
        <mxCell id="c197" parent="1" style="ellipse;html=1;fillColor=#2E3A6E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13;fontFamily=Helvetica;" value="6" vertex="1">
          <mxGeometry height="24" width="24" x="583.333" y="2196.16" as="geometry" />
        </mxCell>
        <mxCell id="c198" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;fontFamily=Helvetica;fontSize=14;fontColor=#2B2B2B;" value="&lt;div style=&quot;font-size:16px;color:#2E3A6E;margin-bottom:0px;line-height:1.38;font-weight:bold;&quot;&gt;Job 3: summary and final result&lt;/div&gt;" vertex="1">
          <mxGeometry height="24.08" width="454.333" x="613.333" y="2194.16" as="geometry" />
        </mxCell>
        <mxCell id="c199" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;fontFamily=Helvetica;fontSize=14;fontColor=#2B2B2B;" value="&lt;div style=&quot;font-size:12.5px;color:#2B2B2B;margin-bottom:6px;line-height:1.32;&quot;&gt;Always runs last. It collects every artifact, publishes one table (category and status) on the run&#39;s summary page, and sets the final result: any failed, blocked or missing category fails the run, and in strict mode so does an unfinished one.&lt;/div&gt;" vertex="1">
          <mxGeometry height="51.5" width="487.333" x="583.333" y="2224.16" as="geometry" />
        </mxCell>
        <mxCell id="c200" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;fontFamily=Helvetica;fontSize=14;fontColor=#2B2B2B;" value="&lt;div style=&quot;font-size:16px;color:#2E3A6E;margin-bottom:0px;line-height:1.38;font-weight:bold;&quot;&gt;Running it locally&lt;/div&gt;" vertex="1">
          <mxGeometry height="24.08" width="487.333" x="1099.67" y="1612.16" as="geometry" />
        </mxCell>
        <mxCell id="c201" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;fontFamily=Helvetica;fontSize=14;fontColor=#2B2B2B;" value="&lt;div style=&quot;font-size:12.5px;color:#2B2B2B;margin-bottom:6px;line-height:1.32;&quot;&gt;The same scripts run on a developer machine (WSL2 or Linux with Docker, .NET 8, Node 22; Java 17 for load):&lt;/div&gt;" vertex="1">
          <mxGeometry height="35" width="487.333" x="1099.67" y="1638.24" as="geometry" />
        </mxCell>
        <mxCell id="c203" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;fontFamily=Helvetica;fontSize=14;fontColor=#2B2B2B;" value="&lt;div style=&quot;font-size:12.5px;color:#2B2B2B;margin-bottom:2px;line-height:1.38;&quot;&gt;bash testing-pipeline/shared/start-environment.sh start&lt;/div&gt;&lt;div style=&quot;font-size:12.5px;color:#2B2B2B;margin-bottom:2px;line-height:1.38;&quot;&gt;bash testing-pipeline/&amp;lt;category&amp;gt;/run.sh&lt;/div&gt;&lt;div style=&quot;font-size:12.5px;color:#2B2B2B;margin-bottom:2px;line-height:1.38;&quot;&gt;bash testing-pipeline/shared/start-environment.sh stop&lt;/div&gt;" vertex="1">
          <mxGeometry height="57.75" width="467.333" x="1119.67" y="1688.16" as="geometry" />
        </mxCell>
        <mxCell id="c204" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;fontFamily=Helvetica;fontSize=14;fontColor=#2B2B2B;" value="&lt;div style=&quot;font-size:12.5px;color:#2B2B2B;margin-bottom:6px;line-height:1.32;&quot;&gt;Unit and mutation testing need no environment. Each category folder has a README with its own commands, demo options and results.&lt;/div&gt;" vertex="1">
          <mxGeometry height="35" width="487.333" x="1099.67" y="1768.3700000000001" as="geometry" />
        </mxCell>
        <mxCell id="c205" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;fontFamily=Helvetica;fontSize=14;fontColor=#2B2B2B;" value="&lt;div style=&quot;font-size:16px;color:#2E3A6E;margin-bottom:0px;line-height:1.38;font-weight:bold;&quot;&gt;Tools and versions&lt;/div&gt;" vertex="1">
          <mxGeometry height="24.08" width="487.333" x="1099.67" y="1807" as="geometry" />
        </mxCell>
        <mxCell id="c206" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;fontFamily=Helvetica;fontSize=14;fontColor=#2B2B2B;" value="&lt;div style=&quot;font-size:13px;color:#2E3A6E;margin-bottom:0px;line-height:1.38;font-weight:bold;&quot;&gt;Area&lt;/div&gt;" vertex="1">
          <mxGeometry height="19.94" width="100" x="1110.67" y="1838.91" as="geometry" />
        </mxCell>
        <mxCell id="c207" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;fontFamily=Helvetica;fontSize=14;fontColor=#2B2B2B;" value="&lt;div style=&quot;font-size:13px;color:#2E3A6E;margin-bottom:0px;line-height:1.38;font-weight:bold;&quot;&gt;Tools&lt;/div&gt;" vertex="1">
          <mxGeometry height="19.94" width="387.333" x="1210.67" y="1839.91" as="geometry" />
