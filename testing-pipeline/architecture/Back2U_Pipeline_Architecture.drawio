        <mxCell id="c133" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;fontFamily=Helvetica;fontSize=14;fontColor=#2B2B2B;" value="&lt;div style=&quot;font-size: 13.5px; color: rgb(46, 101, 51); margin-bottom: 6px; line-height: 1.38; font-weight: bold;&quot;&gt;shared validate-report&lt;/div&gt;&lt;div style=&quot;font-size: 12.5px; color: rgb(43, 43, 43); margin-bottom: 3px; line-height: 1.38; padding-left: 16px; text-indent: -12px;&quot;&gt;•&amp;nbsp;&amp;nbsp;rejects empty or malformed reports&lt;/div&gt;&lt;div style=&quot;font-size: 12.5px; color: rgb(43, 43, 43); margin-bottom: 3px; line-height: 1.38; padding-left: 16px; text-indent: -12px;&quot;&gt;•&amp;nbsp; Every case needs a name, description and status&lt;/div&gt;&lt;div style=&quot;font-size: 12.5px; color: rgb(43, 43, 43); margin-bottom: 3px; line-height: 1.38; padding-left: 16px; text-indent: -12px;&quot;&gt;•&amp;nbsp; A failed case can&#39;t exit 0&lt;/div&gt;&lt;div style=&quot;font-size: 12.5px; color: rgb(43, 43, 43); margin-bottom: 0px; line-height: 1.38; padding-left: 16px; text-indent: -12px;&quot;&gt;•&amp;nbsp; Then writes status.txt&lt;/div&gt;" vertex="1">
          <mxGeometry height="121.88" width="226" x="465" y="1344.29" as="geometry" />
        </mxCell>
