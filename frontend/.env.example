# Each microservice has its own base URL (no API gateway).
# In dev (Vite proxy): leave auth empty for relative paths — Vite proxies /api/auth to localhost:5261.
# In prod: set to the full auth-service URL.
VITE_AUTH_API_BASE_URL=
VITE_ITEM_API_BASE_URL=http://localhost:5001
VITE_MATCHING_API_BASE_URL=http://localhost:5002
VITE_ADMIN_API_BASE_URL=http://localhost:5003
